# Entorno de ejecucion de la aplicacion (development, staging, production)
ENVIRONMENT=development

# Credenciales y datos de conexion de PostgreSQL usados por docker-compose para levantar el servicio postgres
POSTGRES_USER=soil_user
POSTGRES_PASSWORD=soil_password
POSTGRES_DB=soil_platform

# URL de conexion asincrona a la base de datos, usada por SQLAlchemy con el driver asyncpg
DATABASE_URL=postgresql+asyncpg://soil_user:soil_password@postgres:5432/soil_platform

# Clave secreta usada para firmar y verificar los JWT. Debe ser unica, larga y aleatoria en produccion
SECRET_KEY=change-this-to-a-long-random-secret-in-production

# Algoritmo criptografico usado para firmar los JWT
JWT_ALGORITHM=HS256

# Minutos de vigencia del access token antes de expirar
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dias de vigencia del refresh token antes de expirar
REFRESH_TOKEN_EXPIRE_DAYS=7

# Nombre de la cookie httpOnly donde se almacena el refresh token
REFRESH_COOKIE_NAME=refresh_token

# Indica si la cookie de refresh token requiere HTTPS (debe ser True en produccion)
COOKIE_SECURE=True

# Limite de intentos de login por IP por minuto, aplicado con slowapi para mitigar fuerza bruta
RATE_LIMIT_LOGIN=5/minute

# Origenes permitidos por CORS, separados por coma y sin espacios
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Credenciales por defecto de pgAdmin (unicamente para entornos locales de desarrollo)
PGADMIN_DEFAULT_EMAIL=admin@soilplatform.local
PGADMIN_DEFAULT_PASSWORD=admin

# API key de Google AI Studio, usada para los embeddings (text-embedding-004) y el chat (Gemini) del agente RAG
GOOGLE_API_KEY=tu_api_key_de_google_ai_studio
