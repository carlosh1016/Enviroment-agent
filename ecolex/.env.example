# Entorno de ejecucion de la aplicacion (development, staging, production)
ENVIRONMENT=development

# Credenciales y datos de conexion de PostgreSQL usados por docker-compose para levantar el servicio postgres
POSTGRES_USER=ecolex_user
POSTGRES_PASSWORD=ecolex_password
POSTGRES_DB=ecolex

# URL de conexion asincrona a la base de datos, usada por SQLAlchemy con el driver asyncpg
DATABASE_URL=postgresql+asyncpg://ecolex_user:ecolex_password@postgres:5432/ecolex

# Clave secreta usada para firmar y verificar los JWT. Debe ser unica, larga y aleatoria en produccion
SECRET_KEY=genera-con-openssl-rand-hex-32

# Algoritmo criptografico usado para firmar los JWT
JWT_ALGORITHM=HS256

# Minutos de vigencia del access token antes de expirar
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dias de vigencia del refresh token antes de expirar
REFRESH_TOKEN_EXPIRE_DAYS=7

# Nombre de la cookie httpOnly donde se almacena el refresh token
REFRESH_COOKIE_NAME=refresh_token

# Indica si la cookie de refresh token requiere HTTPS. True en produccion (HTTPS real).
# Si corres todo en local por HTTP (localhost), pon esto en False: un navegador descarta
# cualquier cookie Secure que no venga de HTTPS, asi que con True el refresh token nunca se
# reenvia y la sesion se cae silenciosamente al expirar el access token (30 min).
COOKIE_SECURE=True

# Limite de intentos de login por IP por minuto, aplicado con slowapi para mitigar fuerza bruta
RATE_LIMIT_LOGIN=5/minute

# Origenes permitidos por CORS, separados por coma y sin espacios
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API key de OpenRouter, usada para: limpiar/estructurar texto de PDFs y transcribir paginas escaneadas
# (ingesta), generar embeddings (qwen/qwen3-embedding-8b) y responder en el chat RAG (ver app/services/openrouter_client.py)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Credenciales del usuario admin del tenant _base (corpus normativo compartido), creado por la migracion 0003.
# BASE_ADMIN_PASSWORD debe estar definida ANTES de correr `docker compose up --build`, ya que la migracion
# lee esta variable en el momento de aplicarse para hashear la contrasena inicial del admin base.
BASE_ADMIN_EMAIL=admin@base.ecolex.internal
BASE_ADMIN_PASSWORD=changeme_en_produccion
